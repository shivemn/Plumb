{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "description": "A sentence the model wrote. It must cite at least one fact.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "fact_ids"
      ],
      "title": "Claim",
      "type": "object"
    },
    "CommitEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "commit",
          "default": "commit",
          "title": "Kind",
          "type": "string"
        },
        "sha": {
          "pattern": "^[0-9a-f]{7,40}$",
          "title": "Sha",
          "type": "string"
        }
      },
      "required": [
        "sha"
      ],
      "title": "CommitEvidence",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "description": "Something Plumb found without AI, with the evidence for it.",
      "properties": {
        "id": {
          "pattern": "^f[0-9]+$",
          "title": "Id",
          "type": "string"
        },
        "topic": {
          "$ref": "#/$defs/Topic",
          "default": "general"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence": {
          "items": {
            "discriminator": {
              "mapping": {
                "commit": "#/$defs/CommitEvidence",
                "file": "#/$defs/FileEvidence",
                "issue": "#/$defs/IssueEvidence"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/FileEvidence"
              },
              {
                "$ref": "#/$defs/CommitEvidence"
              },
              {
                "$ref": "#/$defs/IssueEvidence"
              }
            ]
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "statement",
        "evidence"
      ],
      "title": "Fact",
      "type": "object"
    },
    "FileEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "file",
          "default": "file",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "description": "Path from the repo root, with forward slashes.",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        }
      },
      "required": [
        "path"
      ],
      "title": "FileEvidence",
      "type": "object"
    },
    "IssueEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "issue",
          "default": "issue",
          "title": "Kind",
          "type": "string"
        },
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        }
      },
      "required": [
        "number"
      ],
      "title": "IssueEvidence",
      "type": "object"
    },
    "RemovedClaim": {
      "additionalProperties": false,
      "description": "A sentence the verifier dropped, and why. Shown so readers can check the checker.",
      "properties": {
        "section": {
          "title": "Section",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "section",
        "text",
        "reason"
      ],
      "title": "RemovedClaim",
      "type": "object"
    },
    "RepoKind": {
      "description": "What kind of repo this is. Decides which section leads the report.",
      "enum": [
        "service",
        "library",
        "cli",
        "data",
        "website",
        "docs",
        "small",
        "unknown"
      ],
      "title": "RepoKind",
      "type": "string"
    },
    "RepoRef": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "commit": {
          "pattern": "^[0-9a-f]{7,40}$",
          "title": "Commit",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "name",
        "commit"
      ],
      "title": "RepoRef",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "description": "One part of a report, such as the system design or how to contribute.",
      "properties": {
        "id": {
          "pattern": "^[a-z_]+$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "claims"
      ],
      "title": "Section",
      "type": "object"
    },
    "Topic": {
      "description": "What a fact is about. The prompt planner picks facts for each section by topic.",
      "enum": [
        "kind",
        "languages",
        "skipped",
        "build",
        "system",
        "settings",
        "migrations",
        "entry_points",
        "structure",
        "history",
        "general"
      ],
      "title": "Topic",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "What the web app renders: verified claims, grouped into sections.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "repo": {
      "$ref": "#/$defs/RepoRef"
    },
    "kind": {
      "$ref": "#/$defs/RepoKind"
    },
    "model": {
      "description": "The model that wrote the claims, as provider:model.",
      "title": "Model",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "title": "Sections",
      "type": "array"
    },
    "removed": {
      "items": {
        "$ref": "#/$defs/RemovedClaim"
      },
      "title": "Removed",
      "type": "array"
    },
    "facts": {
      "description": "Every fact a kept claim cites, so the report stands alone.",
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    }
  },
  "required": [
    "repo",
    "kind",
    "model",
    "sections",
    "removed",
    "facts"
  ],
  "title": "Report",
  "type": "object"
}
